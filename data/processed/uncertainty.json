kind": "change", "metric": "conceded_shot_15s_pct", "state": "All", "team": "Real Madrid", "period": "2005-09>2013-17", "matches": null, "value": -3.01, "lo": -5.24, "hi": -0.77, "clear": 1}, {"key": "conceded_shot_15s_pct|All|Real Madrid|2005-09>2017-21", "kind": "change", "metric": "conceded_shot_15s_pct", "state": "All", "team": "Real Madrid", "period": "2005-09>2017-21", "matches": null, "value": -3.5, "lo": -6.33, "hi": -0.59, "clear": 1}, {"key": "conceded_shot_15s_pct|All|Real Madrid|2009-13>2013-17", "kind": "change", "metric": "conceded_shot_15s_pct", "state": "All", "team": "Real Madrid", "period": "2009-13>2013-17", "matches": null, "value": 1.7, "lo": 0.46, "hi": 2.99, "clear": 1}, {"key": "conceded_shot_15s_pct|All|Real Madrid|2009-13>2017-21", "kind": "change", "metric": "conceded_shot_15s_pct", "state": "All", "team": "Real Madrid", "period": "2009-13>2017-21", "matches": null, "value": 1.21, "lo": -1.0, "hi": 3.54, "clear": 0}, {"key": "conceded_shot_15s_pct|All|Real Madrid|2013-17>2017-21", "kind": "change", "metric": "conceded_shot_15s_pct", "state": "All", "team": "Real Madrid", "period": "2013-17>2017-21", "matches": null, "value": -0.49, "lo": -2.56, "hi": 1.66, "clear": 0}], "meta": [{"label": "scripts/uncertainty.py", "value": "\"\"\"Step 5: bootstrap intervals for period averages and for changes between periods (uncertainty.json).\n\nEach period average rests on 6-8 matches. The unit of resampling is the match (events within a match are\nnot independent): for every team, period and game state, matches are drawn with replacement and the\nmetric is recomputed as a ratio of sums, B times. The 5th and 95th percentiles give a 90% interval.\nA change between two periods is the difference of independent resamples; if its interval excludes 0,\nthe change is unlikely to be an artefact of which matches happened to be played.\nInput: match_team.json (build.py), game_state.json (game_state.py).\n\"\"\"\nimport os\nimport random\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nfrom clasico import PERIODS, PROCESSED, TEAMS  # noqa: E402\nfrom clasico.output import read_json, read_rows, write_rows  # noqa: E402\n\nOUT = sys.argv[1] if len(sys.argv) > 1 else PROCESSED\nRESAMPLES = 5000\nSEED = 2021\nLEVEL = 0.90\n# metric: (numerator, denominator, scale, available by game state)\nMETRICS = {\n    'passes_per_shot': ('passes_before_shot_sum', 'open_play_shots', 1, True),\n    'press_success_pct': ('pressures_won_5s', 'pressures', 100, True),\n    'stripped_per100': ('balls_stripped', 'opp_controls', 100, True),\n    'ppda': ('opp_buildup_passes', 'def_actions', 1, True),\n    'conceded_shot_15s_pct': ('conceded_shot_15s', 'turnovers', 100, False),\n}\n\n\ndef ratio(rows, a, b, k):\n    den = sum(r[b] for r in rows)\n    return k * sum(r[a] for r in rows) / den if den else None\n\n\ndef boot(rows, a, b, k, rng):\n    \"\"\"RESAMPLES resampled values in draw order (not sorted: differences between periods pair draw i with draw i).\n    A resample with an empty denominator keeps the observed value, so both lists stay length RESAMPLES.\"\"\"\n    obs = ratio(rows, a, b, k)\n    out = []\n    for _ in range(RESAMPLES):\n        v = ratio([rng.choice(rows) for _ in rows], a, b, k)\n        out.append(obs if v is None else v)\n    return out\n\n\ndef pct(vals, q):\n    s = sorted(vals)\n    return s[min(len(s) - 1, max(0, round(q * (len(s) - 1))))]\n\n\ndef main():\n    rng = random.Random(SEED)\n    match_team = read_json(os.path.join(OUT, 'match_team.json'))\n    game_states = read_rows(os.path.join(OUT, 'game_state.json'))\n    lo, hi = (1 - LEVEL) / 2, 1 - (1 - LEVEL) / 2\n    rows, samples = [], {}\n    for metric, (a, b, k, by_state) in METRICS.items():\n        for state in (('All', 'Level') if by_state else ('All',)):\n            src = match_team if state == 'All' else [g for g in game_states if g['state'] == state]\n            for team in TEAMS:\n                for p in PERIODS:\n                    rs = [r for r in src if r['team'] == team and r['period'] == p]\n                    s = boot(rs, a, b, k, rng)\n                    samples[(metric, state, team, p)] = s\n                    rows.append(dict(key=f'{metric}|{state}|{team}|{p}', kind='period', metric=metric, state=state,\n                                     team=team, period=p, matches=len(rs), value=round(ratio(rs, a, b, k), 2),\n                                     lo=round(pct(s, lo), 2), hi=round(pct(s, hi), 2)))\n                for i, p1 in enumerate(PERIODS):\n                    for p2 in PERIODS[i + 1:]:\n                        s1, s2 = samples[(metric, state, team, p1)], samples[(metric, state, team, p2)]\n                        d = [y - x for x, y in zip(s1, s2)]   # independent draws, paired by index\n                        v1 = next(r['value'] for r in rows if r['key'] == f'{metric}|{state}|{team}|{p1}')\n                        v2 = next(r['value'] for r in rows if r['key'] == f'{metric}|{state}|{team}|{p2}')\n                        dlo, dhi = pct(d, lo), pct(d, hi)\n                        rows.append(dict(key=f'{metric}|{state}|{team}|{p1}>{p2}', kind='change', metric=metric,\n                                         state=state, team=team, period=f'{p1}>{p2}', matches=None,\n                                         value=round(v2 - v1, 2), lo=round(dlo, 2), hi=round(dhi, 2),\n                                         clear=1 if dlo > 0 or dhi < 0 else 0))\n    write_rows(os.path.join(OUT, 'uncertainty.json'), rows, os.path.abspath(__file__))\n    clear = sum(r['clear'] for r in rows if r['kind'] == 'change')\n    total = sum(1 for r in rows if r['kind'] == 'change')\n    print(f'uncertainty: {len(rows)} rows, {RESAMPLES} resamples, {LEVEL:.0%} intervals; '\n          f'{clear}/{total} period changes clear of zero')\n\n\nif __name__ == '__main__':\n    main()\n", "type": "code", "lang": "python"}, {"label": "clasico/events.py", "value": "\"\"\"Shared definitions on event data. Every metric uses these functions, so changing a definition here\nchanges every output together.\"\"\"\n\nLOSS_KIND = {'Dispossessed': 'Dispossessed', 'Miscontrol': 'Miscontrol', 'Dribble': 'Failed dribble'}\nSTRIP_WINDOW = 12     # seconds after a ball receipt in which a loss is looked for\nSTRIP_LOOKAHEAD = 40  # maximum number of events scanned ahead\nSTATES = ('Ahead', 'Level', 'Behind')\n\n\ndef sec(e):\n    \"\"\"Event time within its half, in seconds.\"\"\"\n    h, m, s = e['timestamp'].split(':')\n    return int(h) * 3600 + int(m) * 60 + float(s)\n\n\ndef is_clean_receipt(e):\n    \"\"\"A successful ball receipt: Ball Receipt* without an outcome (such as Incomplete).\"\"\"\n    return e['type']['name'] == 'Ball Receipt*' and 'outcome' not in e.get('ball_receipt', {})\n\n\ndef is_loss(e):\n    \"\"\"Losing the ball before releasing it: Dispossessed, Miscontrol or a failed dribble.\"\"\"\n    n = e['type']['name']\n    return n in ('Dispossessed', 'Miscontrol') or (n == 'Dribble' and e['dribble']['outcome']['name'] == 'Incomplete')\n\n\ndef strip_after(ev, i):\n    \"\"\"If ev[i] is a successful receipt, return the loss event when the same player's first meaningful\n    action with the ball (carries skipped) is a loss; otherwise None. Search stays in the same half\n    and within 12 seconds.\"\"\"\n    e = ev[i]\n    team, player, t0 = e['team']['name'], e['player']['id'], sec(e)\n    for f in ev[i + 1:i + STRIP_LOOKAHEAD]:\n        if f['period'] != e['period'] or sec(f) - t0 > STRIP_WINDOW:\n            return None\n        if f.get('player', {}).get('id') != player or f['team']['name'] != team:\n            continue\n        if f['type']['name'] == 'Carry':\n            continue\n        return f if is_loss(f) else None\n    return None\n\n\ndef possessions(ev):\n    \"\"\"Group events by StatsBomb possession number, half by half.\"\"\"\n    seqs = []\n    for per in (1, 2):\n        cur = None\n        for e in ev:\n            if e['period'] != per:\n                continue\n            if cur is None or e['possession'] != cur['p']:\n                cur = dict(p=e['possession'], team=e['possession_team']['name'], pp=e['play_pattern']['name'], es=[], per=per)\n                seqs.append(cur)\n            cur['es'].append(e)\n    return seqs\n\n\ndef passes_before(es, shot):\n    \"\"\"Completed passes by the shooting team within the possession before the shot.\"\"\"\n    t = shot['team']['name']\n    return sum(1 for e in es if e['type']['name'] == 'Pass' and e['team']['name'] == t\n               and e['index'] < shot['index'] and 'outcome' not in e['pass'])\n\n\ndef zone(x, y):\n    \"\"\"Split the pitch into 3 x 3 equal zones (40 x 26.7 each), team attacking left to right:\n    1-3 own third, 4-6 middle third, 7-9 attacking third.\"\"\"\n    third = 0 if x < 40 else 1 if x < 80 else 2\n    lane = 0 if y < 80 / 3 else 1 if y < 160 / 3 else 2\n    return 1 + lane + 3 * third\n\n\ndef is_goal(e):\n    return (e['type']['name'] == 'Shot' and e['shot']['outcome']['name'] == 'Goal') or e['type']['name'] == 'Own Goal For'\n\n\ndef score_before(ev, teams):\n    \"\"\"For every event, the goals scored BEFORE it {team: goals}. ev must be sorted by index.\"\"\"\n    score = {t: 0 for t in teams}\n    out = []\n    for e in ev:\n        out.append(dict(score))\n        if is_goal(e):\n            score[e['team']['name']] += 1\n    return out, score\n\n\ndef game_state(score, team, opp):\n    d = score[team] - score[opp]\n    return 'Ahead' if d > 0 else 'Behind' if d < 0 else 'Level'\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "StatsBomb Open Data (github.com/statsbomb/open-data), La Liga 2005/06-2020/21, 29 Real Madrid - Barcelona matches"}]}